# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase
FIREBASE_PROJECT_ID=

# Google Gemini AI
GEMINI_API_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Payment Providers
TELEBIRR_API_KEY=
TELEBIRR_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_SECRET_KEY=
SANTIMPAY_API_KEY=
SANTIMPAY_SECRET_KEY=

# Station ticketing
# PAYMENT_PROVIDER defaults to disabled when unset. The dev provider requires
# APP_ENV=development and PAYMENT_PROVIDER=dev at runtime.
QR_SIGNING_SECRET=
QR_SIGNING_KID=
QR_SIGNING_PREVIOUS_KEYS=
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
APP_ENV=

# Auth Enforcement
# false (default): verify tokens when present, but log and continue without one.
# true: reject unauthenticated/unauthorized requests with 401/403.
# Safe rollout:
#   1. Deploy with AUTH_ENFORCE=false.
#   2. Confirm clients send "Authorization: Bearer <Firebase ID token>".
#   3. Call a protected route with no token and confirm it is logged.
#   4. Verify a normal signed-in flow still works.
#   5. Set AUTH_ENFORCE=true and repeat steps 3-4: no token -> 401, signed-in -> 200.
AUTH_ENFORCE=false
